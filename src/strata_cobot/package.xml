<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>strata_cobot</name>
  <version>1.0.0</version>
  <description>Strata Cobot course project: ore sorting with a UR7e arm and path planning for a mobile robot.</description>
  <maintainer email="saihardhikreddy@gmail.com">C Saihardhik Reddy</maintainer>
  <author>C Saihardhik Reddy</author>
  <author>R Gagan Chowdary</author>
  <author>K Charan Saatvikh Reddy</author>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
